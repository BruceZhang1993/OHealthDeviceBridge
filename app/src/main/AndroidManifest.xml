<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <uses-permission android:name="android.permission.INTERNET" />
    <queries>
        <package android:name="com.xiaomi.smarthome" />
        <package android:name="com.heytap.health" />
    </queries>

    <application
        android:allowBackup="false"
        android:description="@string/xposed_description"
        android:label="@string/app_name"
        android:supportsRtl="true">
        <activity android:name=".xiaomi.MiHomeAuthorizeActivity" android:exported="true"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />
        <provider android:name=".xiaomi.MiHomeProvider"
            android:authorities="${applicationId}.mihome" android:exported="true" android:grantUriPermissions="true" />
    </application>
</manifest>
